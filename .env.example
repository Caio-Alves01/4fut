# Copie para .env (no servidor) e preencha. NUNCA suba o .env para o git.
# Gere senhas/chaves com:  openssl rand -base64 48 | tr -d '/+='

DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Chave do JWT (mínimo 32 caracteres)
JWT_KEY=cole-aqui-uma-chave-aleatoria-longa

# Chave do hash de CPF. NÃO mude depois que houver usuários cadastrados.
CPF_HASH_KEY=cole-aqui-outra-chave-aleatoria-longa

# Verificação de idade pelo CPF (CPFHub.io). Sem a API key, aprova só pela data informada.
CPF_BASE_URL=https://api.cpfhub.io
CPF_API_KEY=

# Opcional: e-mail (necessário para recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
